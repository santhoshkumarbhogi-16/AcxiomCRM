@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Leads";
}

<div class="page-heading">
    <div><div class="eyebrow">LEAD MANAGEMENT</div><h1 class="h3 mb-1">Leads</h1><p class="text-muted mb-0">Qualify prospects and move them through your sales workflow.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add lead</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-7"><label for="q" class="form-label">Search leads</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Name, company, email, or phone" /></div>
        <div class="col-md-3"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var status in new[] { "New", "Contacted", "Qualified", "Unqualified", "Converted", "Lost" }){<option value="@status" selected="@(ViewBag.Status == status)">@status</option>}</select></div>
        <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search"></i> Search</button></div>
    </form>
</div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Lead</th><th>Company</th><th>Source / Priority</th><th>Expected value</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var lead in Model)
    {
        <tr>
            <td><div class="fw-semibold">@lead.LeadName</div><small class="text-muted">@lead.LeadCode · @lead.Email</small></td>
            <td>@lead.CompanyName</td>
            <td>@lead.Source <span class="text-muted">·</span> @lead.Priority</td>
            <td>₹ @lead.ExpectedValue.ToString("N0")</td>
            <td><span class="badge @(lead.Status == "Qualified" ? "text-bg-primary" : lead.Status == "Converted" ? "text-bg-success" : "text-bg-secondary")">@lead.Status</span></td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-secondary">View</a>
                <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-primary">Edit</a>
                <form method="post" asp-action="Delete" asp-route-id="@lead.LeadId" class="d-inline" onsubmit="return confirm('Delete this lead?')">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="6"><div class="empty-state"><i class="bi bi-person-lines-fill fs-2"></i><p class="mb-0 mt-2">No leads match your search.</p></div></td></tr>
    }
    </tbody>
</table></div>
@await Html.PartialAsync("_Pagination")
</div>
