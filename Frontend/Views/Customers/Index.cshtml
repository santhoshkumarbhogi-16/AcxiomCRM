@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-heading">
    <div><div class="eyebrow">CUSTOMER MANAGEMENT</div><h1 class="h3 mb-1">Customers</h1><p class="text-muted mb-0">Manage your customer relationships and account details.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add customer</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-7"><label class="form-label" for="q">Search customers</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Name, email, phone, or company" /></div>
        <div class="col-md-3"><label class="form-label" for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option><option selected="@(ViewBag.Status == "Active")">Active</option><option selected="@(ViewBag.Status == "Inactive")">Inactive</option></select></div>
        <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search"></i> Search</button></div>
    </form>
</div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Customer</th><th>Company</th><th>Email / Phone</th><th>Created</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var customer in Model)
    {
        <tr>
            <td><div class="fw-semibold">@customer.CustomerName</div><small class="text-muted">@customer.CustomerCode</small></td>
            <td>@customer.CompanyName</td>
            <td><div>@customer.Email</div><small class="text-muted">@customer.Phone</small></td>
            <td>@customer.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
            <td><span class="badge @(customer.Status == "Active" ? "text-bg-success" : "text-bg-secondary")">@customer.Status</span></td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-outline-secondary">View</a>
                <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (customer.Status == "Active")
                {
                    <form method="post" asp-action="Delete" asp-route-id="@customer.CustomerId" class="d-inline" onsubmit="return confirm('Deactivate this customer?')">
                        <button class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="6"><div class="empty-state"><i class="bi bi-people fs-2"></i><p class="mb-0 mt-2">No customers match your search.</p></div></td></tr>
    }
    </tbody>
</table></div>
@await Html.PartialAsync("_Pagination")
</div>
