@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Edit customer";
}

<div class="page-heading">
    <div><div class="eyebrow">CUSTOMER MANAGEMENT</div><h1 class="h3 mb-1">Edit customer</h1><p class="text-muted mb-0">@Model.CustomerCode</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to customers</a>
</div>
<div class="card form-card"><div class="card-body p-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" class="row g-3">
        <input asp-for="CustomerId" type="hidden" />
        <div class="col-md-6"><label asp-for="CustomerName" class="form-label">Customer name</label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="CompanyName" class="form-label">Company</label><input asp-for="CompanyName" class="form-control" /><span asp-validation-for="CompanyName" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" maxlength="10" /><span asp-validation-for="Phone" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="field-validation"></span></div>
        <div class="col-md-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="field-validation"></span></div>
        <div class="col-md-3"><label asp-for="State" class="form-label"></label><input asp-for="State" class="form-control" /><span asp-validation-for="State" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Active</option><option>Inactive</option></select><span asp-validation-for="Status" class="field-validation"></span></div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="col-md-6"><label asp-for="AssignedTo" class="form-label">Assigned Sales Executive</label><select asp-for="AssignedTo" asp-items="ViewBag.SalesExecutives" class="form-select"><option value="">Select owner</option></select><span asp-validation-for="AssignedTo" class="field-validation"></span></div>
        }
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><span asp-validation-for="Notes" class="field-validation"></span></div>
        <div class="col-12"><button class="btn btn-primary">Save changes</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div>
    </form>
</div></div>
