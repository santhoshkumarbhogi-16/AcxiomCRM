@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Schedule follow-up";
}

<div class="page-heading">
    <div><div class="eyebrow">SALES WORKSPACE</div><h1 class="h3 mb-1">Schedule follow-up</h1><p class="text-muted mb-0">Create a reminder linked to one CRM record.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to follow-ups</a>
</div>
<div class="card form-card"><div class="card-body p-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" class="row g-3">
        <div class="col-md-6"><label asp-for="Subject" class="form-label">Subject</label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="FollowUpType" class="form-label">Type</label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select><span asp-validation-for="FollowUpType" class="field-validation"></span></div>
        <div class="col-md-4"><label asp-for="FollowUpDate" class="form-label">Date</label><input asp-for="FollowUpDate" class="form-control" type="date" /><span asp-validation-for="FollowUpDate" class="field-validation"></span></div>
        <div class="col-md-4"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"><option value="">Select customer</option></select><span asp-validation-for="CustomerId" class="field-validation"></span></div>
        <div class="col-md-4"><label asp-for="LeadId" class="form-label">Lead</label><select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select"><option value="">Select lead</option></select><span asp-validation-for="LeadId" class="field-validation"></span></div>
        <div class="col-md-6"><label asp-for="OpportunityId" class="form-label">Opportunity</label><select asp-for="OpportunityId" asp-items="ViewBag.Opportunities" class="form-select"><option value="">Select opportunity</option></select><span asp-validation-for="OpportunityId" class="field-validation"></span></div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="col-md-6"><label asp-for="AssignedTo" class="form-label">Assign to Sales Executive</label><select asp-for="AssignedTo" asp-items="ViewBag.SalesExecutives" class="form-select"><option value="">Select owner</option></select><span asp-validation-for="AssignedTo" class="field-validation"></span></div>
        }
        <div class="col-md-6"><label asp-for="Remarks" class="form-label">Notes</label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea><span asp-validation-for="Remarks" class="field-validation"></span></div>
        <input asp-for="Status" type="hidden" />
        <div class="col-12"><button class="btn btn-primary">Schedule follow-up</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div>
    </form>
</div></div>
