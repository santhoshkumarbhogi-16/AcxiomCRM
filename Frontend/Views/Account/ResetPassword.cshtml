@model AcxiomCRM.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-shell">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="eyebrow mb-2">ACCOUNT SECURITY</div>
            <h1 class="h3 mb-2">Set a new password</h1>
            <p class="text-muted mb-4">Choose a new password that meets the account security policy.</p>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <form method="post">
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="field-validation"></span></div>
                <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div>
                <button class="btn btn-primary w-100">Change password</button>
            </form>
        </div>
    </div>
</div>
