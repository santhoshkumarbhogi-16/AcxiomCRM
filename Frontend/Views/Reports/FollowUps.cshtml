@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-up report";
}

<div class="page-heading">
    <div><div class="eyebrow">REPORTS</div><h1 class="h3 mb-1">Follow-up report</h1><p class="text-muted mb-0">Track scheduled, completed, missed, and overdue follow-ups.</p></div>
    <a asp-controller="FollowUps" asp-action="Create" class="btn btn-primary">Schedule follow-up</a>
</div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-md-3"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var status in new[] { "Planned", "Completed", "Missed", "Cancelled" }){<option value="@status" selected="@(ViewBag.Status == status)">@status</option>}</select></div>
    <div class="col-md-3"><label for="from" class="form-label">From</label><input id="from" name="from" type="date" value="@ViewBag.From" class="form-control" /></div>
    <div class="col-md-3"><label for="to" class="form-label">To</label><input id="to" name="to" type="date" value="@ViewBag.To" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
</form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Date</th><th>Subject</th><th>Type</th><th>Related ID</th><th>Status</th></tr></thead>
    <tbody>@foreach (var x in Model){<tr><td>@x.FollowUpDate.ToString("dd MMM yyyy")</td><td>@x.Subject</td><td>@x.FollowUpType</td><td>@(x.CustomerId.HasValue ? $"Customer #{x.CustomerId}" : x.LeadId.HasValue ? $"Lead #{x.LeadId}" : $"Opportunity #{x.OpportunityId}")</td><td>@x.Status@if(x.Status == "Planned" && x.FollowUpDate.Date < DateTime.Today){<span class="badge text-bg-danger ms-2">Overdue</span>}</td></tr>}
    @if (!Model.Any()){<tr><td colspan="5"><div class="empty-state">No follow-ups match these filters.</div></td></tr>}</tbody>
</table></div>
@await Html.PartialAsync("_Pagination")
</div>
