@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity report";
}

<div class="page-heading">
    <div><div class="eyebrow">REPORTS</div><h1 class="h3 mb-1">Opportunity report</h1><p class="text-muted mb-0">Pipeline stage, deal value, probability, and close dates.</p></div>
    <a asp-controller="Opportunities" asp-action="Index" class="btn btn-outline-secondary">Manage opportunities</a>
</div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-md-4"><label for="q" class="form-label">Search</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Opportunity or customer" /></div>
    <div class="col-md-3"><label for="stage" class="form-label">Stage</label><select id="stage" name="stage" class="form-select"><option value="">All stages</option>@foreach(var value in new[] {"Qualification","Proposal","Negotiation","Won","Lost"}){<option value="@value" selected="@(ViewBag.Stage == value)">@value</option>}</select></div>
    <div class="col-md-3"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All</option><option value="Open" selected="@(ViewBag.Status == "Open")">Open</option><option value="Closed" selected="@(ViewBag.Status == "Closed")">Closed</option></select></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
</form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Name</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close</th><th>Status</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.OpportunityName</td><td>@(x.Customer?.CustomerName ?? (x.LeadId.HasValue ? $"Lead #{x.LeadId}" : "—"))</td><td>@x.Stage</td><td>₹ @x.Amount.ToString("N2")</td><td>@x.Probability%</td><td>₹ @x.WeightedValue.ToString("N2")</td><td>@x.ExpectedCloseDate.ToString("dd MMM yyyy")</td><td>@x.Status</td></tr>}
@if (!Model.Any()){<tr><td colspan="8"><div class="empty-state">No opportunities match these filters.</div></td></tr>}
</tbody></table></div>
@await Html.PartialAsync("_Pagination")
</div>
