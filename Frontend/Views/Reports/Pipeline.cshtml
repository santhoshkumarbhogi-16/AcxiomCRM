@{
    ViewData["Title"] = "Pipeline report";
    var stages = (IEnumerable<dynamic>)ViewBag.Stages;
    var owners = (IEnumerable<dynamic>)ViewBag.Owners;
}

<div class="page-heading">
    <div><div class="eyebrow">REPORTS</div><h1 class="h3 mb-1">Sales pipeline</h1><p class="text-muted mb-0">Open opportunity totals by stage and owner.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to reports</a>
</div>
<div class="card mb-3"><div class="card-body d-flex justify-content-between align-items-center"><div><div class="metric-label">TOTAL OPEN PIPELINE</div><div class="pipeline-value">₹ @(((decimal)ViewBag.Total).ToString("N2"))</div></div><a asp-controller="Opportunities" asp-action="Index" class="btn btn-primary">View opportunities</a></div></div>
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">By stage</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Stage</th><th>Deals</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var x in stages){<tr><td>@x.Stage</td><td>@x.Count</td><td class="text-end">₹ @(((decimal)x.Amount).ToString("N2"))</td></tr>}@if(!stages.Any()){<tr><td colspan="3" class="text-muted">No open opportunities.</td></tr>}</tbody></table></div></div></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">By owner</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Owner</th><th>Deals</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var x in owners){<tr><td>@x.Name</td><td>@x.Count</td><td class="text-end">₹ @(((decimal)x.Amount).ToString("N2"))</td></tr>}@if(!owners.Any()){<tr><td colspan="3" class="text-muted">No open opportunities.</td></tr>}</tbody></table></div></div></div></div>
</div>
