@{
    ViewData["Title"] = "User activity report";
    var rows = (IEnumerable<dynamic>)Model;
    var userNames = (IDictionary<string, string>)ViewBag.UserNames;
}

<div class="page-heading">
    <div><div class="eyebrow">REPORTS</div><h1 class="h3 mb-1">User activity</h1><p class="text-muted mb-0">Audited actions grouped by account and operation.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to reports</a>
</div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>User</th><th>Action</th><th>Count</th><th>Most recent</th></tr></thead><tbody>
@foreach (var row in rows){<tr><td>@(userNames.TryGetValue((string)row.UserId, out var email) ? email : (string)row.UserId)</td><td>@row.Action</td><td>@row.Count</td><td>@(((DateTime)row.Latest).ToLocalTime().ToString("dd MMM yyyy, h:mm tt"))</td></tr>}
@if(!rows.Any()){<tr><td colspan="4"><div class="empty-state">No user activity has been recorded.</div></td></tr>}
</tbody></table></div>
@await Html.PartialAsync("_Pagination")
</div>
