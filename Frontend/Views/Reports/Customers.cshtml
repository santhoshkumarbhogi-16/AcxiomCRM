@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer report";
}

<div class="page-heading">
    <div><div class="eyebrow">REPORTS</div><h1 class="h3 mb-1">Customer report</h1><p class="text-muted mb-0">Customer status, contact, and creation details.</p></div>
    <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-secondary">Manage customers</a>
</div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-md-7"><label for="q" class="form-label">Search</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Name, email, or company" /></div>
    <div class="col-md-3"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option><option value="Active" selected="@(ViewBag.Status == "Active")">Active</option><option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option></select></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
</form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Code</th><th>Customer</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th>Created</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.CustomerCode</td><td>@x.CustomerName</td><td>@x.Email</td><td>@x.Phone</td><td>@x.CompanyName</td><td>@x.Status</td><td>@x.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}
@if (!Model.Any()){<tr><td colspan="7"><div class="empty-state">No customers match these filters.</div></td></tr>}
</tbody></table></div>
@await Html.PartialAsync("_Pagination")
</div>
