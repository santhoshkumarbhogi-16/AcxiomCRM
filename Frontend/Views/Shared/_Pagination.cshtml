@{
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var routeData = ViewBag.RouteData as IDictionary<string, string> ?? new Dictionary<string, string>();
}
<div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a class="btn btn-sm btn-outline-secondary" asp-all-route-data="routeData" asp-route-csv="true">
        <i class="bi bi-download"></i> Export CSV
    </a>
    @if (totalPages > 1)
    {
    <nav aria-label="List pages">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="routeData" asp-route-page="@(currentPage - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @currentPage of @totalPages</span></li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="routeData" asp-route-page="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
    }
</div>
