@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@inject SignInManager<ApplicationUser> SignInManager
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid app-container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark">A</span><span>Acxiom<span class="brand-light">CRM</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Overview</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index"><i class="bi bi-person-lines-fill"></i> Leads</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index"><i class="bi bi-briefcase"></i> Opportunities</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index"><i class="bi bi-calendar-check"></i> Follow-ups</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index"><i class="bi bi-activity"></i> Activities</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> Users</a></li>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index"><i class="bi bi-shield-check"></i> Audit</a></li>
                            }
                        </ul>
                        <div class="user-menu">
                            <span class="user-avatar">@((User.Identity?.Name ?? "U")[0].ToString().ToUpperInvariant())</span>
                            <span class="user-name">@User.Identity?.Name</span>
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right"></i> Sign out</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto d-flex gap-2">
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create account</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main class="app-container page-content">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>
    <footer class="app-footer">
        <div class="app-container d-flex justify-content-between flex-wrap gap-2">
            <span>AcxiomCRM <span class="text-muted">Customer relationship workspace</span></span>
            <span class="text-muted">© @DateTime.UtcNow.Year AcxiomCRM</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
