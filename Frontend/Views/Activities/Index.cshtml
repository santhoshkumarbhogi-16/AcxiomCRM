@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activities";
}

<div class="page-heading">
    <div><div class="eyebrow">SALES WORKSPACE</div><h1 class="h3 mb-1">Activities</h1><p class="text-muted mb-0">Review calls, meetings, emails, and tasks linked to your records.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Record activity</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5"><label for="q" class="form-label">Search</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Subject or type" /></div>
        <div class="col-md-3"><label for="date" class="form-label">Date</label><input id="date" name="date" type="date" value="@ViewBag.Date" class="form-control" /></div>
        <div class="col-md-2"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All</option><option value="Open" selected="@(ViewBag.Status == "Open")">Open</option><option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option><option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option></select></div>
        <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
    </form>
</div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Date</th><th>Activity</th><th>Related record</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ActivityDate.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</td>
            <td><div class="fw-semibold">@item.Subject</div><small class="text-muted">@item.ActivityType · @item.Description</small></td>
            <td>@(item.CustomerId.HasValue ? $"Customer #{item.CustomerId}" : item.LeadId.HasValue ? $"Lead #{item.LeadId}" : $"Opportunity #{item.OpportunityId}")</td>
            <td><span class="badge @(item.Status == "Completed" ? "text-bg-success" : "text-bg-secondary")">@item.Status</span></td>
            <td class="text-end">
                @if (item.Status == "Open")
                {
                    <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form method="post" asp-action="UpdateStatus" asp-route-id="@item.ActivityId" class="d-inline"><input type="hidden" name="status" value="Completed" /><button class="btn btn-sm btn-outline-success">Complete</button></form>
                    <form method="post" asp-action="UpdateStatus" asp-route-id="@item.ActivityId" class="d-inline"><input type="hidden" name="status" value="Cancelled" /><button class="btn btn-sm btn-outline-secondary">Cancel</button></form>
                }
                <form method="post" asp-action="Delete" asp-route-id="@item.ActivityId" class="d-inline" onsubmit="return confirm('Delete this activity?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5"><div class="empty-state"><i class="bi bi-activity fs-2"></i><p class="mb-0 mt-2">No activities match these filters.</p></div></td></tr>
    }
    </tbody>
</table></div>
@await Html.PartialAsync("_Pagination")
</div>
