@{
    ViewData["Title"] = "Something went wrong";
}

<div class="auth-shell">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5 text-center">
            <span class="metric-icon icon-orange mb-3"><i class="bi bi-exclamation-triangle"></i></span>
            <h1 class="h3">Something went wrong</h1>
            <p class="text-muted">We couldn't complete that request. Please try again, or contact an administrator if the problem continues.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Return to dashboard</a>
        </div>
    </div>
</div>
