@model IEnumerable<AcxiomCRM.Models.ApplicationUser>
@{
    ViewData["Title"] = "User administration";
    var userRoles = (IDictionary<string, string>)ViewBag.UserRoles;
}

<div class="page-heading">
    <div><div class="eyebrow">ADMINISTRATION</div><h1 class="h3 mb-1">Users & roles</h1><p class="text-muted mb-0">Manage account access and role assignments.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Create user</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2">
        <div class="col-md-8"><label for="q" class="form-label">Search users</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Name or email" /></div>
        <div class="col-auto align-self-end"><button class="btn btn-outline-primary">Search</button></div>
    </form>
</div></div>
@if (ViewBag.ResetUrl is string resetUrl)
{
    <div class="alert alert-warning" role="status">
        <strong>One-time password reset link:</strong>
        <a href="@resetUrl" class="alert-link text-break">@resetUrl</a>
        <div class="small mt-1">Share this link with the user through a trusted channel. The link expires after one hour.</div>
    </div>
}
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>User</th><th>Primary role</th><th>Account</th><th>Lockout</th><th class="text-end">Manage</th></tr></thead>
    <tbody>
    @foreach (var user in Model)
    {
        var role = userRoles[user.Id];
        <tr>
            <td><div class="fw-semibold">@user.FullName</div><small class="text-muted">@user.Email</small></td>
            <td><span class="badge text-bg-light">@role</span></td>
            <td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
            <td>@(user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow ? $"Locked until {user.LockoutEnd.Value.ToLocalTime():g}" : "—")</td>
            <td class="text-end text-nowrap">
                <form method="post" asp-action="ChangeRole" asp-route-id="@user.Id" class="d-inline-flex gap-1">
                    <select name="role" class="form-select form-select-sm" aria-label="Role for @user.Email">
                        @foreach (var value in new[] { "SalesExecutive", "Manager", "Admin" })
                        {
                            <option value="@value" selected="@(role == value)">@((value == "SalesExecutive") ? "Sales Executive" : value)</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-primary">Save role</button>
                </form>
                <form method="post" asp-action="Toggle" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('@(user.IsActive ? "Deactivate" : "Activate") this account?')">
                    <button class="btn btn-sm btn-outline-secondary">@(user.IsActive ? "Deactivate" : "Activate")</button>
                </form>
                @if (user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow)
                {
                    <form method="post" asp-action="Unlock" asp-route-id="@user.Id" class="d-inline">
                        <button class="btn btn-sm btn-outline-warning">Unlock</button>
                    </form>
                }
                <form method="post" asp-action="StartPasswordReset" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('Create a one-time password reset link for this user?')">
                    <button class="btn btn-sm btn-outline-info">Reset password</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5"><div class="empty-state">No users match your search.</div></td></tr>
    }
    </tbody>
</table></div>
@await Html.PartialAsync("_Pagination")
</div>
